# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
LLM_PROVIDER=openai
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120
OPENAI_MAX_RETRIES=6

# ── Database connections (JSON map of name → SQLAlchemy URL) ──────────────────
# PostgreSQL local development connection
DB_CONNECTIONS={"default": "postgresql+psycopg2://qm_user:qm_pass@127.0.0.1:5432/querymind"}

# ── Metadata DB ────────────────────────────────────────────────────────────────
METADATA_DB_URL=postgresql+psycopg2://qm_user:qm_pass@127.0.0.1:5432/querymind_meta

# ── Storage backend ────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# ── Scheduler backend ─────────────────────────────────────────────────────────
SCHEDULER_BACKEND=apscheduler

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_ENABLED=false
# JSON map of api_key -> role.  Roles: admin | readonly
API_KEYS={"dev-key-change-me": "admin"}

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_API=120/minute

# ── Memory ────────────────────────────────────────────────────────────────────
MEMORY_WINDOW_TURNS=10

# ── Server ports ───────────────────────────────────────────────────────────────
API_PORT=8101
UI_PORT=8502

# ── Environment ────────────────────────────────────────────────────────────────
ENVIRONMENT=local
