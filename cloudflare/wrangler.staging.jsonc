{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "querymind-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "vars": {
    "ENVIRONMENT": "staging",
    "AI_PROVIDER": "openai_gateway",
    "OPENAI_MODEL": "gpt-4o",
    "ALLOWED_OPENAI_MODELS": "gpt-4o,gpt-4o-mini",
    "AI_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/cff1ce3bf222cd50e22dcefa3f651fa0/querymind-prod/openai/chat/completions",
    "AI_GATEWAY_BYOK_ALIAS": "production",
    "AI_MOCK_MODE": "false",
    "AI_USER_REQUESTS_PER_HOUR": "20",
    "AI_GLOBAL_REQUESTS_PER_DAY": "200",
    "AI_MAX_PROMPT_CHARACTERS": "8000",
    "SEMANTIC_RUNTIME_CONTEXT_ENABLED": "false",
    "AUTH_REQUIRED": "true",
    "AUTH_TOKEN_TTL_SECONDS": "28800",
    "AUTH_LOGIN_ATTEMPTS_PER_15_MINUTES": "20"
  },
  "d1_databases": [
    {
      "binding": "QUERYMIND_DATA",
      "database_name": "querymind-staging-data",
      "database_id": "2f3e6d96-04e4-49be-9222-93977fe9387c",
      "migrations_dir": "migrations/data"
    },
    {
      "binding": "QUERYMIND_APP",
      "database_name": "querymind-staging-app",
      "database_id": "b5773b44-2fa2-48e8-84f6-ec838eecdf91",
      "migrations_dir": "migrations/app"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  }
}
