{
  "name": "querymind-cloudflare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "dev:test": "wrangler dev --local --port 8787 --persist-to .wrangler-test",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types ./src/worker-configuration.d.ts --strict-vars=false",
    "check": "npm run types && npm run typecheck",
    "data:convert": "node scripts/csv-to-d1.mjs",
    "test:db:init": "node scripts/init-local-test.mjs",
    "test:bootstrap": "node scripts/bootstrap-test-owner.mjs",
    "test": "npm run test:unit",
    "test:unit": "playwright test tests/security.spec.ts tests/explainability.spec.ts tests/semantic.spec.ts tests/semantic-suggestions.spec.ts tests/approved-semantic-context.spec.ts",
    "test:e2e": "playwright test tests/app.spec.ts tests/rbac.spec.ts tests/semantic-api.spec.ts tests/semantic-suggestions-api.spec.ts tests/semantic-suggestions-ui.spec.ts",
    "test:all": "playwright test",
    "migration:check": "node scripts/check-migration-immutability.mjs",
    "release:manifest:check": "node scripts/release-manifest.mjs",
    "release:manifest:p12": "node scripts/release-manifest.mjs ../docs/releases/manifests/p1.2-feedback-trust.json",
    "release:preflight": "node scripts/release-preflight.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "deploy:dry-run": "wrangler deploy --config wrangler.production.jsonc --dry-run",
    "deploy:production": "node scripts/deploy-production.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.31.1"
  }
}
