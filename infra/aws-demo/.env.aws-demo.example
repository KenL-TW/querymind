# QueryMind AWS on-demand demo environment.
# Copy to infra/aws-demo/.env.aws-demo on the EC2 host and fill real secrets.

ENVIRONMENT=production
ENV=production

# Public URL host used by CORS metadata and documentation.
# Examples:
#   PUBLIC_HOST=ec2-xx-xx-xx-xx.ap-northeast-1.compute.amazonaws.com
#   PUBLIC_HOST=203.0.113.10
PUBLIC_HOST=localhost

# FastAPI runs only inside the Docker network. Nginx exposes port 80.
API_PORT=8080

# Auth must be enabled for any AWS demo.
AUTH_ENABLED=true
JWT_SECRET=replace-with-a-random-32-plus-character-secret
DEFAULT_OWNER_EMAIL=owner@local
DEFAULT_OWNER_API_KEY=replace-bootstrap-owner-api-key
ANONYMOUS_ROLE=viewer

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
LLM_ROUTING_ENABLED=false

# PostgreSQL container databases.
POSTGRES_USER=qm_user
POSTGRES_PASSWORD=replace-with-strong-postgres-password
QUERYMIND_APP_DB=querymind
QUERYMIND_META_DB=querymind_meta
POSTGRES_DB=querymind

# App database URLs. These point to the postgres service name inside Compose.
METADATA_DB_URL=postgresql+psycopg2://qm_user:replace-with-strong-postgres-password@postgres:5432/querymind_meta
DB_CONNECTIONS={"default":"postgresql+psycopg2://qm_user:replace-with-strong-postgres-password@postgres:5432/querymind"}

# Persistent host path. Mount this from the EBS volume.
QUERYMIND_DATA_ROOT=/mnt/querymind
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage
SCHEDULER_BACKEND=apscheduler
AWS_EVENTBRIDGE_ROLE_ARN=

# Same-origin frontend behind Nginx can use a relative API base.
NUXT_PUBLIC_API_BASE=

# Keep explicit origins for the future CORS hardening patch.
CORS_ORIGINS=["http://localhost"]
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_API=120/minute
MEMORY_WINDOW_TURNS=10
SESSION_RETENTION_DAYS=90
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL_SECONDS=120
