# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
LLM_PROVIDER=openai
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# ── Database connections ───────────────────────────────────────────────────────
# PostgreSQL production connection
DB_CONNECTIONS={"default": "postgresql://user:password@your-rds-host:5432/your_db", "analytics": "postgresql://user:password@your-rds-host:5432/analytics_db"}

# ── Metadata DB ────────────────────────────────────────────────────────────────
METADATA_DB_URL=postgresql://user:password@your-rds-host:5432/querymind_meta

# ── Storage backend ────────────────────────────────────────────────────────────
STORAGE_BACKEND=s3
AWS_S3_BUCKET=your-querymind-bucket
AWS_REGION=ap-northeast-1

# ── Scheduler backend ─────────────────────────────────────────────────────────
SCHEDULER_BACKEND=eventbridge
AWS_EVENTBRIDGE_ROLE_ARN=arn:aws:iam::123456789012:role/QueryMindSchedulerRole

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_ENABLED=true
# Rotate keys regularly; store in AWS Secrets Manager in production
API_KEYS={"prod-key-replace-me": "admin", "readonly-key-replace-me": "readonly"}

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_API=120/minute

# ── Memory ────────────────────────────────────────────────────────────────────
MEMORY_WINDOW_TURNS=10

# ── Server ports ───────────────────────────────────────────────────────────────
API_PORT=8101
UI_PORT=8502

# ── Environment ────────────────────────────────────────────────────────────────
ENVIRONMENT=production
